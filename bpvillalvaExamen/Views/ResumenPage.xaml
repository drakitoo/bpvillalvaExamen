<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="bpvillalvaExamen.Views.ResumenPage"
             BackgroundColor="#F4F6FA"
             Title="Resumen">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12" MaximumWidthRequest="760"
                             HorizontalOptions="Center">
            <Label x:Name="UsuarioConectadoLabel" FontSize="14" TextColor="#202020"
                   HorizontalTextAlignment="Center" />
            <Label Text="RESUMEN" FontSize="24" FontAttributes="Bold"
                   TextColor="#C62828" HorizontalTextAlignment="Center" />
            <Border BackgroundColor="White" Padding="20" Stroke="#E5E7EB"
                    StrokeShape="RoundRectangle 18">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                      ColumnDefinitions="*,Auto" RowSpacing="14" ColumnSpacing="20">
                    <Label Grid.Row="0" Text="Nombre" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="NombreLabel" Grid.Row="0" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="1" Text="Apellido" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="ApellidoLabel" Grid.Row="1" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="2" Text="Edad" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="EdadLabel" Grid.Row="2" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="3" Text="Fecha" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="FechaLabel" Grid.Row="3" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="4" Text="Ciudad" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="CiudadLabel" Grid.Row="4" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="5" Text="País" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="PaisLabel" Grid.Row="5" Grid.Column="1" TextColor="#202020" HorizontalTextAlignment="End" />
                    <Label Grid.Row="6" Text="Monto inicial" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="MontoInicialLabel" Grid.Row="6" Grid.Column="1" TextColor="#C62828" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    <Label Grid.Row="7" Text="Pago mensual" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="PagoMensualLabel" Grid.Row="7" Grid.Column="1" TextColor="#C62828" FontAttributes="Bold" HorizontalTextAlignment="End" />
                    <Label Grid.Row="8" Text="Pago total" TextColor="#202020" FontAttributes="Bold" />
                    <Label x:Name="PagoTotalLabel" Grid.Row="8" Grid.Column="1" TextColor="#C62828" FontAttributes="Bold" HorizontalTextAlignment="End" />
                </Grid>
            </Border>
            <Button Text="VOLVER AL REGISTRO" Clicked="Volver_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>